# Local provider settings, including the API key.
foo-ai.toml

# Resumed conversations.
.foo-ai/

# Reasonix local data.
.reasonix/

# Local Python virtual environment.
.venv/

# Python bytecode caches.
__pycache__/

# Setuptools metadata (e.g. foo_ai.egg-info/).
*.egg-info/

# Bench run output. The probes are committed; a report is not.
bench/results/

# Editor swap files, which can hold a copy of foo-ai.toml.
*.swp

# Electron desktop shell: installed packages and built installers.
desktop/node_modules/
desktop/release/
